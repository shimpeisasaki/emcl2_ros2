# Caller supplies a unique ID (1..128 bytes). Duplicate accepted IDs are idempotent.
string request_id
builtin_interfaces/Duration timeout
---
uint8 ACCEPTED=0
uint8 BUSY=1
uint8 DISABLED=2
uint8 INVALID_REQUEST=3
uint8 NOT_READY=4
uint8 NO_GNSS=5
bool accepted
string attempt_id
uint8 reason_code
string reason
